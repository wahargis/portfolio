flowchart TD
    CONTEXT["Actor + community + surface + feature state"] --> CATALOG["Server computes capability catalog"]
    CATALOG --> MODEL["Model receives admitted schemas"]
    MODEL --> CALL["Structured tool call"]
    CALL --> PARSE{"Known name and valid arguments?"}
    PARSE -->|no| REJECT["Structured rejection"]
    PARSE -->|yes| SCOPE{"Trusted scope and domain authorization?"}
    SCOPE -->|no| CLOSED["Fail closed"]
    SCOPE -->|yes| ISO["Isolated task + timeout"]
    ISO --> READ["Read / analysis tool"]
    ISO --> EFFECT["Product action / durable artifact"]
    READ --> RESULT["Normalized result + source identity"]
    EFFECT --> RECEIPT["Domain effect + durable receipt"]
    ISO -->|raise, exit, timeout| HONEST["Honest model-visible failure"]
    RESULT --> LOOP["Return to bounded runtime"]
    RECEIPT --> LOOP
    HONEST --> LOOP
