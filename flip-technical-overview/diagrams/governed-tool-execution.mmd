flowchart LR
  subgraph TOP["TOOL REQUEST PATH"]
    T0["Model request\nTool name and user-controlled; arguments from the current round"]
    T1["Capability lookup\nTool admitted for this actor,; surface, route and feature state"]
    T0 --> T1
    T2["Schema validation\nTyped arguments, size and format,; unsupported fields rejected"]
    T1 --> T2
    T3["Trusted scope injection\nActor, community, origin, AI identity,; workspace and operation identity"]
    T2 --> T3
    T4["Authorization and execution\nOwning product or external service,; timeout, concurrency and retry class"]
    T3 --> T4
    T5["Normalized result\nDurable result or effect identity,; status, evidence and failure returned"]
    T4 --> T5
  end
  subgraph BOTTOM["RESULT CLASSES"]
    B0["Read-only result\nScoped product record, source,; document passage or analysis data"]
    B1["Committed product effect\nValidated mutation with canonical; identity, lifecycle and client event"]
    B2["Pending asynchronous artifact\nProvider attempt, progress, terminal; state, cancellation and continuation"]
    B3["Refusal or failure\nUnknown tool, invalid schema, denied; scope, timeout or unsafe retry"]
  end
  T5 --> B0
  T5 --> B1
  T5 --> B2
  T5 --> B3
