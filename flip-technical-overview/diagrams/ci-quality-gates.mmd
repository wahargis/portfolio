flowchart LR
    CHANGE["Code, schema, client, or route change"] --> DET["Deterministic gates"]
    DET --> UNIT["Domain + authorization tests"]
    DET --> INT["Database, jobs, migrations, provider adapters"]
    DET --> CLIENT["Client sync, reconciliation, native build"]
    DET --> SEC["Security and dependency checks"]
    UNIT --> BUILD["Compile / release / container build"]
    INT --> BUILD
    CLIENT --> BUILD
    SEC --> BUILD
    BUILD --> SCEN["Selected end-to-end scenarios"]
    SCEN --> EVAL["Versioned AI route and curation evaluation"]
    EVAL --> RELEASE{"Evidence acceptable?"}
    RELEASE -->|yes| SHIP["Deploy"]
    RELEASE -->|no| BLOCK["Block or constrain route / feature"]
    SHIP --> OBS["Operational and user quality signals"]
    OBS --> EVAL
