flowchart TD
    CHAT["Eligible chat conversation"] --> SELECT["Select source messages and relationships"]
    SELECT --> PLAN["Model-assisted topic and destination plan"]
    PLAN --> VALIDATE{"Valid source set, authorship, destination, and duplicate state?"}
    VALIDATE -->|no| REPAIR["Repair or defer to review"]
    REPAIR --> PLAN
    VALIDATE -->|yes| APPLY["Transactional forum create / append / merge"]
    APPLY --> SOURCE["Persist source-message and participant relationships"]
    SOURCE --> BRIDGE["Add bounded structural bridge context"]
    BRIDGE --> LINK["Asynchronous linkback to source conversation"]
    LINK --> FEEDBACK["Participant feedback and correction"]
    FEEDBACK --> RECURATE{"Recuration warranted?"}
    RECURATE -->|yes, bounded| PLAN
    RECURATE -->|no| DURABLE["Durable forum knowledge with inspectable provenance"]
