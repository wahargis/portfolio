    T5["6. Complete later stages\nLinkback, notification, feedback,; repair and bounded recuration"]
    T4 --> T5
  end
  subgraph BOTTOM["PROVENANCE AND FAILURE STATE"]
    B0["Source authorship\nHuman messages retain participant and; message identity; AI additions are marked"]
    B1["Origin-aware access\nDestination visibility cannot broaden; a more restrictive source boundary"]
    B2["Partial result\nCompleted publication remains durable; when linkback or notification later fails"]
    B3["Correction history\nFeedback and recuration retain the; prior selection, run and publication"]
  end
  T4 --> B0
  T4 --> B1
  T5 --> B2
