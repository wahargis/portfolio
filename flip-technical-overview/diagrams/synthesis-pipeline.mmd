flowchart TD
    TRIGGER["Chat message / room config"] --> ENABLE{synthesis enabled?}
    ENABLE -->|no| SKIP["No synthesis"]
    ENABLE -->|yes| JOB["Background AI job"]
    JOB --> LOOP["Bounded gather phase"]
    LOOP --> TOOLS["Governed tools (search / read)"]
    TOOLS --> SOURCES["Sources + citations collected"]
    SOURCES --> TERMINAL["Terminal phase: final plan"]
    TERMINAL --> PLAN["Curation plan / synthesis text"]
    PLAN --> PERSIST["Persist forum thread or reply"]
    PERSIST --> LINK["Link to source messages"]
    LINK --> CITE["Attach quote-verified citations"]
    CITE --> LEDGER["Write source ledger entries"]
    LEDGER --> DONE["Synthesis visible with provenance"]
