flowchart LR
  subgraph TOP["TURN ADMISSION AND EXECUTION"]
    T0["1. Product trigger\nMention, reply, product command,; or artifact continuation"]
    T1["2. Resolve scope\nActor, AI identity, community,; origin, visibility, feature state"]
    T0 --> T1
    T2["3. Build context\nConversation, authorized retrieval,; sources, documents and artifacts"]
    T1 --> T2
    T3["4. Admit route and tools\nModel capability, trusted scope,; deadlines and effect policy"]
    T2 --> T3
    T4["5. Run model and tools\nWorking rounds, typed calls,; validated results and limits"]
    T3 --> T4
    T5["6. Commit terminal result\nValidate reply and references,; store activity and publish object"]
    T4 --> T5
  end
  subgraph BOTTOM["DURABLE OUTCOME AND RECOVERY"]
    B0["Activity and evidence\nRoute, rounds, tool state, sources,; citations, artifacts and failure class"]
    B1["Product object\nMessage, forum update, action, file,; chart, poll or generated artifact"]
    B2["Client convergence\nAPI response, durable sync, realtime; event and optimistic reconciliation"]
    B3["Continuation\nPending artifact completes later and; starts one deduplicated scoped turn"]
  end
  T5 --> B0
  T5 --> B1
  T5 --> B2
  T4 --> B3
