  subgraph BOTTOM["CLIENT RECONCILIATION"]
    B0["Deduplicate\nLocal transaction, canonical identity; and server version collapse delivery paths"]
    B1["Offline recovery\nReload durable state without replaying; all missed realtime events"]
    B2["Capability negotiation\nRender authentication, upload, push,; sync and AI features actually available"]
    B3["Access revocation\nRemove cached records, controls and; local search after projection changes"]
  end
  T0 --> T1
