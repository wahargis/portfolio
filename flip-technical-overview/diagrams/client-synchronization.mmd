flowchart LR
    subgraph CLIENT["Web / desktop / mobile client"]
      UI["UI state"]
      OPT["Optimistic mutation"]
      CACHE["Authorized durable cache"]
      EPH["Presence / typing / transient progress"]
      UI --> OPT
      CACHE --> UI
    end
    subgraph SERVER["Phoenix server authority"]
      CMD["HTTP / domain command"]
      AUTH["Authorization + validation"]
      DB[("PostgreSQL")]
      CH["Channels / PubSub"]
      SHAPE["Electric shapes"]
      CMD --> AUTH
      AUTH --> DB
      DB --> SHAPE
    end
    OPT --> CMD
    SHAPE --> CACHE
    AUTH -->|canonical identity / transaction| OPT
    EPH <--> CH
