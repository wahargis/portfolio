flowchart LR
    subgraph SERVER["Server"]
        DB[("Server database<br/>(logical replication enabled)")]
        SYNC["Sync service"]
        APP["Web application API + realtime channels"]
        DB --> SYNC
        DB --> APP
    end
    subgraph CLIENT["Native desktop client"]
        SHAPES["Synced data shapes in memory"]
        UI["Desktop UI"]
        QUEUE["Optimistic send queue (replays on reconnect)"]
        IND["Offline indicator"]
        SYNC -->|live shape sync| SHAPES
        SHAPES --> UI
        QUEUE --> APP
        APP --> IND
        IND --> UI
    end
    APP -->|session refresh / schema update| SHAPES
