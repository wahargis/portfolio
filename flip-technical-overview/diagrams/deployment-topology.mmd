flowchart LR
  subgraph TOP["PRODUCT ENVIRONMENT"]
    T0["Product clients\nReal accounts, communities, web,; desktop and mobile sessions"]
    T1["Product Phoenix application\nProduct configuration, identity,; authorization and domain services"]
    T0 --> T1
    T2["Product state\nDatabase, queues, storage, artifacts,; telemetry and delivery channels"]
    T1 --> T2
    T3["Product providers\nScoped model, search, media, push,; email and connector credentials"]
    T2 --> T3
  end
  subgraph BOTTOM["SYNTHETIC TECHNICAL ENVIRONMENT"]
    B0["Synthetic clients\nNon-production identities, scenarios,; fixtures and controlled capabilities"]
    B1["Synthetic Phoenix application\nSame contract classes and failure; paths under separate configuration"]
    B0 --> B1
    B2["Synthetic state\nSeparate database, queues, storage,; hostnames, callbacks and telemetry"]
    B1 --> B2
    B3["Fixtures or test providers\nDeterministic streams or independently; scoped test credentials and quotas"]
    B2 --> B3
  end
  TOP -. separate data and authority .- BOTTOM
