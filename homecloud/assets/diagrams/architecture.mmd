flowchart TD
    subgraph clients["Clients"]
        LV["HomeCloud LiveView<br/>chat, research, vault, infrastructure"]
        API["Agent REST API and MCP<br/>external tools and dispatchers"]
    end

    subgraph app["HomeCloud Phoenix application"]
        EE["ExecutionEngine<br/>autonomous / interactive / plan-only"]
        CE["ContextEngine + ContextManager<br/>token budgeting, RAG, memory retrieval"]
        MR["ModelRouter + InferenceRouter<br/>provider selection, round-robin, failover"]
        IP["InstancePool<br/>adopt-only llama-server pool"]
        TR["ToolRegistry + DynamicToolRegistry<br/>built-in and runtime-synthesized tools"]
        SB["AgentSandbox<br/>Docker-isolated tool execution"]
        CK["Checkpointer + GitCheckpoint<br/>Postgres snapshots and git rollback"]
    end

    subgraph services["Supervised platform services"]
        PG[("PostgreSQL + pgvector")]
