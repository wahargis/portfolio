flowchart TD
    subgraph clients["Clients"]
        UI["Operator dashboard<br/>chat, research, memory, infrastructure"]
        API["Agent API and MCP<br/>external tools and dispatchers"]
    end

    subgraph app["Application layer"]
        EXEC["Agent execution<br/>autonomous / interactive / plan-only"]
        CTX["Context management<br/>token budgeting, RAG, memory retrieval"]
        ROUTE["Model routing<br/>provider selection, round-robin, failover"]
        POOL["Supervised model pool"]
        TOOLS["Tool registry<br/>built-in and runtime tools"]
        SANDBOX["Sandboxed tool execution"]
        CHECK["Checkpoints<br/>session snapshots and rollback"]
    end

    subgraph services["Supervised platform services"]
        DB[("Database + vector storage")]
        HEALTH["Health checks"]
        M1["Primary model service<br/>reserved GPU pair"]
        M2["Research model service<br/>research GPU"]
        M3["Secondary model service<br/>on-demand GPU"]
        SCHED["GPU scheduler + claim registry"]
    end

    subgraph hw["Hardware"]
        G0["GPU0<br/>NVIDIA V100 32GB"]
        G1["GPU1<br/>NVIDIA V100 32GB"]
        G2["GPU2<br/>NVIDIA V100 32GB"]
        G3["GPU3<br/>NVIDIA V100 32GB"]
    end

    UI --> EXEC
    API --> EXEC
    EXEC --> CTX
    EXEC --> ROUTE
    ROUTE --> POOL
    POOL --> M1
    POOL --> M2
    POOL --> M3
    EXEC --> SANDBOX
    EXEC --> CHECK
    CTX --> DB
    CHECK --> DB
    TOOLS --> SANDBOX
    HEALTH --> M1
    HEALTH --> M2
    HEALTH --> M3
